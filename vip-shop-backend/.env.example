# ⚠️ WICHTIG: Diesen Inhalt NICHT in .env kopieren!
# Dies ist nur zur Referenz. Verwende stattdessen Vercel Environment Variables!

PORT=3000
NODE_ENV=production

# ⚠️ WICHTIG: Admin Secret - Ändere diesen Wert in Produktion!
# Mindestens 32 Zeichen, Sonderzeichen empfohlen
ADMIN_SECRET=super_ultra_secret_123_change_me_in_production

# JWT Secret für Token-Authentifizierung - MUSS lang und zufällig sein!
# Mindestens 64 Zeichen
JWT_SECRET=your-super-secret-jwt-key-change-in-production-make-it-very-long-and-random

# Supabase Configuration
# Du bekommst diese Werte von Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# reCAPTCHA Configuration
# Du bekommst diese Keys von: https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=6LczUTksAAAAABug9Imt9vzuSxG7AoxnD2dYcUZW

# Email Configuration (Gmail oder anderer SMTP Provider)
# Für Gmail: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=deine-email@gmail.com
EMAIL_PASSWORD=dein-app-passwort
EMAIL_FROM=deine-email@gmail.com
